{
  "name": "marginshield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MarginShield by Evidence Room — commercial margin control for distributors.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@marginshield/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run tests/golden packages/synthetic packages/engine",
    "test:privacy": "vitest run tests/privacy",
    "test:security": "vitest run tests/security",
    "e2e": "pnpm --filter @marginshield/web exec playwright test",
    "synth": "pnpm --filter @marginshield/synthetic exec tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licence:audit": "node scripts/licence-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^15.14.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}

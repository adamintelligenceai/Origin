{
  "name": "marginshield",
  "private": true,
  "version": "0.1.0",
  "description": "MarginShield by Evidence Room — commercial margin control for distributors",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo run dev --filter=@marginshield/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:golden": "turbo run test:golden --filter=@marginshield/engine",
    "test:privacy": "vitest run --config tests/privacy/vitest.config.ts",
    "e2e": "pnpm --filter @marginshield/web exec playwright test",
    "synth": "pnpm --filter @marginshield/synthetic exec tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "fast-check": "^4.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}

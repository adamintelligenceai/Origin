{
  "name": "project-chief",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.14.0 <25",
    "pnpm": ">=10.14.0 <11"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "env TURBO_TELEMETRY_DISABLED=1 turbo typecheck",
    "test": "env TURBO_TELEMETRY_DISABLED=1 turbo test",
    "security:cloud-schema": "node scripts/check-cloud-schema.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check && pnpm security:cloud-schema"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@react-native/metro-config": "0.86.3",
      "react-native-worklets": "0.10.1"
    }
  }
}

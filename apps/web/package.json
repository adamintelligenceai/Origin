{
  "name": "@marginshield/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:privacy": "vitest run --config vitest.privacy.config.ts",
    "e2e": "playwright test",
    "test:golden": "node -e \"console.log(\"golden tests live in @marginshield/engine\")\""
  },
  "dependencies": {
    "@marginshield/engine": "workspace:*",
    "@marginshield/schemas": "workspace:*",
    "@marginshield/ui": "workspace:*",
    "@marginshield/reports": "workspace:*",
    "@marginshield/api-client": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "@marginshield/synthetic": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@tailwindcss/postcss": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

# Origin runs in demo mode by default (no credentials required).
# To connect a real eToro account, provide EITHER a Bearer token OR an
# API-key pair — never both.

# Port for the Express API (Vite dev server proxies /api here).
ORIGIN_PORT=8787

# eToro trading environment: "demo" or "real". Controls the /demo/ vs /real/
# path segment used for API calls.
ETORO_ENV=demo

# Force demo mode even if credentials are present.
ETORO_DEMO_MODE=true

# --- Option A: Bearer token (SSO access token) ---
# ETORO_ACCESS_TOKEN=

# --- Option B: API key pair (partner integrations) ---
# ETORO_API_KEY=
# ETORO_USER_KEY=

# Override the Public API base URL (defaults to the production host).
# ETORO_API_BASE=https://public-api.etoro.com/api/v1

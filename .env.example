# MarginShield environment — no secrets in the repository.
# Copy to .env.local for local development.

# Public site
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=MarginShield

# Supabase (optional in local demo; required for authenticated app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode (do not use live keys in development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SCAN=
STRIPE_PRICE_FOUNDING=
STRIPE_PRICE_MONITOR=

# Optional AI narrative — product works fully with this unset
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Licence signing (server only)
LICENCE_SIGNING_SECRET=

# Never commit real secrets.

# CONTENT-BLIND CONTROL PLANE ONLY
PUBLIC_APP_ENV=development
CONTROL_PLANE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# LOCAL DEVELOPMENT ONLY.
# Production model credentials must be stored on-device or issued as
# short-lived, task-bounded credentials without logging personal content.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Desktop OAuth. Refresh/access tokens stay in local protected storage.
GOOGLE_CLIENT_ID=
GOOGLE_DESKTOP_REDIRECT_URI=http://127.0.0.1:53682/oauth/google/callback

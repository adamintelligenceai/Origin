{
  "name": "@marginshield/synthetic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "marginshield-synth": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "synth": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"lint: synthetic uses root prettier\""
  },
  "dependencies": {
    "@marginshield/schemas": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

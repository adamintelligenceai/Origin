{
  "name": "@marginshield/synthetic",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "marginshield-synth": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "synth": "node dist/cli.js"
  },
  "dependencies": {
    "@marginshield/schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
